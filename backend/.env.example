PORT=3000

# MongoDB Connection String (e.g. mongodb+srv://<user>:<password>@cluster.mongodb.net/famer?retryWrites=true&w=majority)
MONGODB_URI=mongodb://localhost:27017/smartfarmerai

# Firebase Admin SDK settings
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Google Maps API Key for frontend geometry processing/saving
GOOGLE_MAPS_API_KEY=

# Copernicus / Sentinel-2 credentials (if using authenticated API)
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=

# APIs
WEATHER_API_BASE_URL=https://api.open-meteo.com/v1
DISEASE_MODEL_URL=http://localhost:8000/predict
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# Optional API Keys
# TRANSLATION_API_KEY=
# VOICE_PROVIDER_API_KEY=
